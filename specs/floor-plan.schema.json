{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parking.example/schemas/floor-plan.schema.json",
  "title": "Parking garage floor plan",
  "type": "object",
  "required": ["version", "garage", "floors"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "garage": { "type": "object", "required": ["id", "name", "units"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/text" }, "units": { "enum": ["metres"] } } },
    "floors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/floor" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 200 },
    "point": { "type": "object", "required": ["x", "y"], "additionalProperties": false, "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
    "polygon": { "type": "object", "required": ["points"], "additionalProperties": false, "properties": { "points": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/point" } } } },
    "floor": { "type": "object", "required": ["id", "level", "name", "canvas", "footprint", "routes", "gates", "amenities", "bays"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "level": { "type": "integer", "minimum": 0 }, "name": { "$ref": "#/$defs/text" }, "canvas": { "type": "object", "required": ["width", "height"], "additionalProperties": false, "properties": { "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } } }, "footprint": { "$ref": "#/$defs/polygon" }, "routes": { "type": "array", "items": { "type": "object", "required": ["id", "kind", "direction", "geometry", "centerline", "connectsTo"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "enum": ["driveAisle", "way", "ramp"] }, "direction": { "enum": ["oneWay", "twoWay"] }, "geometry": { "$ref": "#/$defs/polygon" }, "centerline": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/point" } }, "connectsTo": { "type": "array", "items": { "$ref": "#/$defs/id" } } } } }, "gates": { "type": "array", "items": { "type": "object", "required": ["id", "direction", "opening", "connectsTo"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "direction": { "enum": ["inbound", "outbound"] }, "opening": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/point" } }, "connectsTo": { "$ref": "#/$defs/id" } } } }, "amenities": { "type": "array", "items": { "type": "object", "required": ["id", "type", "label", "geometry"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "enum": ["lift", "stairs", "column", "wall"] }, "label": { "$ref": "#/$defs/text" }, "geometry": { "$ref": "#/$defs/polygon" } } } }, "bays": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/bay" } } } },
    "bay": { "type": "object", "required": ["id", "name", "geometry", "labelAt", "spots"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/text" }, "geometry": { "$ref": "#/$defs/polygon" }, "labelAt": { "$ref": "#/$defs/point" }, "spots": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "label", "kind", "routeId", "geometry"], "additionalProperties": false, "properties": { "id": { "$ref": "#/$defs/id" }, "label": { "$ref": "#/$defs/text" }, "kind": { "enum": ["standard", "accessible", "ev"] }, "routeId": { "$ref": "#/$defs/id" }, "geometry": { "type": "object", "required": ["x", "y", "width", "height", "rotation"], "additionalProperties": false, "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 }, "rotation": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 } } } } } } } }
  }
}
